<div class="max-w-4xl mx-auto">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">Settings</h1>
  </div>

  <% if flash[:notice] %>
    <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded mb-6">
      <%= flash[:notice] %>
    </div>
  <% end %>

  <div class="bg-white ring-1 ring-slate-200 rounded-xl p-6">
    <%= form_with url: admin_settings_path, method: :patch, class: "space-y-4" do %>
      <div class="flex items-start gap-3">
        <%= check_box_tag :ig_welcome_enabled, "1", Setting.ig_welcome_enabled?, class: "mt-0.5 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" %>
        <div>
          <%= label_tag :ig_welcome_enabled, "Send welcome message on Instagram", class: "block text-sm font-medium text-slate-700" %>
          <p class="mt-1 text-xs text-slate-500">
            Greets new Instagram conversations with the <code>welcome</code> quick reply, like WhatsApp.
            Turn on only after disabling Instagram's native auto-reply in Meta Business Suite, or new contacts will be greeted twice.
          </p>
        </div>
      </div>

      <div class="pt-2">
        <%= submit_tag "Save", class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
